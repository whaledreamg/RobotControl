/* =====================================================
 * mainwindow.qss - 机器人综合控制系统 (果冻风, 紧凑布局)
 * 使用类型 + role 属性选择器
 * ===================================================== */

QMainWindow#mainWindow {
    background-color: #F2F4F8;
}

QWidget#centralWidget {
    background-color: #F2F4F8;
}

/* ---------- 顶部连接卡 ---------- */
QFrame#topBar {
    background-color: rgba(255, 255, 255, 230);
    border: 1px solid rgba(200, 210, 230, 180);
    border-radius: 12px;
}

QLabel#lblTitle {
    color: #1E1E1E;
    font-weight: bold;
    background: transparent;
}
QLabel#lblSubtitle {
    color: #8A93A6;
    background: transparent;
    font-size: 9pt;
}

QLabel#lblArmIpTitle, QLabel#lblAgvIpTitle,
QLabel#lblArmSpeedSlow, QLabel#lblArmSpeedFast,
QLabel#lblNavStationTitle,
QLabel#lblLiftDeviceTitle, QLabel#lblLiftTargetTitle,
QLabel#lblLiftSpeedTitle, QLabel#lblLiftJogSpeedTitle,
QLabel#lblLiftJogTimeoutTitle {
    color: #5A6478;
    font-size: 11pt;
    background: transparent;
}

QLineEdit#editArmIp, QLineEdit#editAgvIp, QLineEdit#editAgvLockNick {
    background-color: #FFFFFF;
    border: 1px solid #D0D6E0;
    border-radius: 6px;
    padding: 4px 8px;
    min-height: 24px;
}
QLineEdit#editArmIp:focus, QLineEdit#editAgvIp:focus, QLineEdit#editAgvLockNick:focus {
    border-color: #0078D4;
}

QFrame#sep1, QFrame#sep2 {
    color: #C8D0E0;
    background: #C8D0E0;
}

/* =====================================================
 * 按钮 (果冻风) - 配色与 Python 版 ui/theme.py 的 PALETTE 保持一致
 *   常态: 半透明底色 + 深色文字，无描边，圆角 10px
 *   hover: 底色变实色，文字变白
 *   pressed: 在 hover 基础上文字下移 1px
 *   disabled: 统一灰蓝底 + 弱化文字
 * ===================================================== */

/* 海蓝 primary: 连接 / 查看 / 移动 / 点动 / 继续 */
QPushButton#btnConnect, QPushButton#btnArmView, QPushButton#btnLiftMove,
QPushButton#btnLiftJogUp, QPushButton#btnLiftJogDown, QPushButton#btnArmProjectResume {
    background-color: rgba(74, 144, 226, 90);
    color: #357abd;
    border: none;
    border-radius: 10px;
    padding: 7px 16px;
    font-weight: bold;
    font-size: 13px;
}
QPushButton#btnConnect:hover, QPushButton#btnArmView:hover, QPushButton#btnLiftMove:hover,
QPushButton#btnLiftJogUp:hover, QPushButton#btnLiftJogDown:hover, QPushButton#btnArmProjectResume:hover {
    background-color: #4a90e2;
    color: #ffffff;
}
QPushButton#btnConnect:pressed, QPushButton#btnArmView:pressed, QPushButton#btnLiftMove:pressed,
QPushButton#btnLiftJogUp:pressed, QPushButton#btnLiftJogDown:pressed, QPushButton#btnArmProjectResume:pressed {
    background-color: #357abd;
    color: #ffffff;
    padding-top: 8px;
    padding-bottom: 6px;
}
/* 连接按钮: 已连接 (薄荷) / 连接失败 (樱粉)，由代码设置 role 属性 */
QPushButton#btnConnect[role="connected"] {
    background-color: rgba(94, 201, 159, 90);
    color: #3fa37a;
}
QPushButton#btnConnect[role="connected"]:hover {
    background-color: #5ec99f;
    color: #ffffff;
}
QPushButton#btnConnect[role="danger"] {
    background-color: rgba(239, 111, 108, 90);
    color: #c44a47;
}
QPushButton#btnConnect[role="danger"]:hover {
    background-color: #ef6f6c;
    color: #ffffff;
}

/* 薄荷 success: 开始 / 上电 */
QPushButton#btnArmProjectStart, QPushButton#btnLiftEnable, QPushButton#btnAgvNavStart, QPushButton#btnAgvLock {
    background-color: rgba(94, 201, 159, 90);
    color: #3fa37a;
    border: none;
    border-radius: 10px;
    padding: 7px 16px;
    font-weight: bold;
    font-size: 13px;
}
QPushButton#btnArmProjectStart:hover, QPushButton#btnLiftEnable:hover, QPushButton#btnAgvNavStart:hover,
QPushButton#btnAgvLock:hover {
    background-color: #5ec99f;
    color: #ffffff;
}
QPushButton#btnArmProjectStart:pressed, QPushButton#btnLiftEnable:pressed, QPushButton#btnAgvNavStart:pressed,
QPushButton#btnAgvLock:pressed {
    background-color: #3fa37a;
    color: #ffffff;
    padding-top: 8px;
    padding-bottom: 6px;
}

/* 蜜桃 warning: 清除异常 / 暂停 / 下电 */
QPushButton#btnClearError, QPushButton#btnArmProjectPause, QPushButton#btnLiftDisable, QPushButton#btnAgvNavPause {
    background-color: rgba(244, 162, 97, 90);
    color: #d98a4a;
    border: none;
    border-radius: 10px;
    padding: 7px 16px;
    font-weight: bold;
    font-size: 13px;
}
QPushButton#btnClearError:hover, QPushButton#btnArmProjectPause:hover,
QPushButton#btnLiftDisable:hover, QPushButton#btnAgvNavPause:hover {
    background-color: #f4a261;
    color: #ffffff;
}
QPushButton#btnClearError:pressed, QPushButton#btnArmProjectPause:pressed,
QPushButton#btnLiftDisable:pressed, QPushButton#btnAgvNavPause:pressed {
    background-color: #d98a4a;
    color: #ffffff;
    padding-top: 8px;
    padding-bottom: 6px;
}

/* 樱粉 danger: 急停 / 停止 */
QPushButton#btnEstop, QPushButton#btnArmProjectStop, QPushButton#btnAgvEmergency, QPushButton#btnLiftStop {
    background-color: rgba(239, 111, 108, 90);
    color: #c44a47;
    border: none;
    border-radius: 10px;
    padding: 7px 16px;
    font-weight: bold;
    font-size: 13px;
}
QPushButton#btnEstop:hover, QPushButton#btnArmProjectStop:hover,
QPushButton#btnAgvEmergency:hover, QPushButton#btnLiftStop:hover {
    background-color: #ef6f6c;
    color: #ffffff;
}
QPushButton#btnEstop:pressed, QPushButton#btnArmProjectStop:pressed,
QPushButton#btnAgvEmergency:pressed, QPushButton#btnLiftStop:pressed {
    background-color: #c44a47;
    color: #ffffff;
    padding-top: 8px;
    padding-bottom: 6px;
}

/* AGV 急停按钮的“解除急停”状态：薄荷绿（代码设置 estopActive=true） */
QPushButton#btnAgvEmergency[estopActive="true"] {
    background-color: rgba(94, 201, 159, 90);
    color: #3fa37a;
}
QPushButton#btnAgvEmergency[estopActive="true"]:hover {
    background-color: #5ec99f;
    color: #ffffff;
}
QPushButton#btnAgvEmergency[estopActive="true"]:pressed {
    background-color: #3fa37a;
    color: #ffffff;
}

/* 淡紫 purple: 次要操作 (设置 / 地图 / 取消 / 刷新 / 清错) */
QPushButton#btnSettings, QPushButton#btnViewMap, QPushButton#btnAgvNavCancel, QPushButton#btnArmRefresh,
QPushButton#btnLiftClearError, QPushButton#btnLiftRefresh, QPushButton#btnAgvUnlock {
    background-color: rgba(167, 139, 207, 90);
    color: #8466b3;
    border: none;
    border-radius: 10px;
    padding: 7px 16px;
    font-weight: bold;
    font-size: 13px;
}
QPushButton#btnSettings:hover, QPushButton#btnViewMap:hover, QPushButton#btnAgvNavCancel:hover,
QPushButton#btnArmRefresh:hover, QPushButton#btnLiftClearError:hover, QPushButton#btnLiftRefresh:hover,
QPushButton#btnAgvUnlock:hover {
    background-color: #a78bcf;
    color: #ffffff;
}
QPushButton#btnSettings:pressed, QPushButton#btnViewMap:pressed, QPushButton#btnAgvNavCancel:pressed,
QPushButton#btnArmRefresh:pressed, QPushButton#btnLiftClearError:pressed, QPushButton#btnLiftRefresh:pressed,
QPushButton#btnAgvUnlock:pressed {
    background-color: #8466b3;
    color: #ffffff;
    padding-top: 8px;
    padding-bottom: 6px;
}

/* 所有主题按钮的禁用态 */
QPushButton#btnConnect:disabled, QPushButton#btnArmView:disabled, QPushButton#btnLiftMove:disabled,
QPushButton#btnLiftJogUp:disabled, QPushButton#btnLiftJogDown:disabled, QPushButton#btnArmProjectResume:disabled,
QPushButton#btnArmProjectStart:disabled, QPushButton#btnLiftEnable:disabled, QPushButton#btnAgvNavStart:disabled,
QPushButton#btnClearError:disabled, QPushButton#btnArmProjectPause:disabled, QPushButton#btnLiftDisable:disabled,
QPushButton#btnAgvNavPause:disabled,
QPushButton#btnEstop:disabled, QPushButton#btnArmProjectStop:disabled, QPushButton#btnAgvEmergency:disabled,
QPushButton#btnLiftStop:disabled,
QPushButton#btnSettings:disabled, QPushButton#btnViewMap:disabled, QPushButton#btnAgvNavCancel:disabled,
QPushButton#btnArmRefresh:disabled, QPushButton#btnLiftClearError:disabled, QPushButton#btnLiftRefresh:disabled,
QPushButton#btnLeftArmEnable:disabled, QPushButton#btnRightArmEnable:disabled,
QPushButton#btnLeftArmDrag:disabled, QPushButton#btnRightArmDrag:disabled,
QPushButton#btnAgvLock:disabled, QPushButton#btnAgvUnlock:disabled {
    background-color: rgba(220, 228, 238, 120);
    color: #8a99ad;
}

/* 顶部状态点 (使用 objectName 选择器) */
QLabel#armStatusDot, QLabel#agvStatusDot {
    font-size: 14pt;
    color: #999999;
}
QLabel#armStatusLabel, QLabel#agvStatusLabel {
    color: #5A6478;
    font-size: 12px;
    background: transparent;
}

/* ---------- 通用 GroupBox ---------- */
QGroupBox {
    background-color: rgba(255, 255, 255, 230);
    border: 1px solid rgba(200, 210, 230, 180);
    border-radius: 10px;
    margin-top: 14px;
    padding: 10px;
}
QGroupBox::title {
    color: #0078D4;
    background-color: #F2F4F8;
    padding: 0 6px;
    font-weight: bold;
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
}
QGroupBox#liftingGroup,
QGroupBox#armEnableGroup::title,
QGroupBox#armProjectGroup::title {
    color: #5A6478;
}

/* ---------- AGV 方向按钮 ---------- */
QPushButton#btnAgvForward, QPushButton#btnAgvBackward,
QPushButton#btnAgvLeft, QPushButton#btnAgvRight {
    background-color: rgba(74, 144, 226, 90);
    color: #357abd;
    border: none;
    border-radius: 14px;
    padding: 0;
    min-height: 0;
    font-size: 24px;
    font-weight: bold;
}
QPushButton#btnAgvForward:hover, QPushButton#btnAgvBackward:hover,
QPushButton#btnAgvLeft:hover, QPushButton#btnAgvRight:hover {
    background-color: rgba(74, 144, 226, 150);
}
QPushButton#btnAgvForward:pressed, QPushButton#btnAgvBackward:pressed,
QPushButton#btnAgvLeft:pressed, QPushButton#btnAgvRight:pressed,
QPushButton#btnAgvForward:checked, QPushButton#btnAgvBackward:checked,
QPushButton#btnAgvLeft:checked, QPushButton#btnAgvRight:checked {
    background-color: #4a90e2;
    color: #ffffff;
}
QPushButton#btnAgvForward:disabled, QPushButton#btnAgvBackward:disabled,
QPushButton#btnAgvLeft:disabled, QPushButton#btnAgvRight:disabled {
    background-color: rgba(220, 228, 238, 120);
    color: #8a99ad;
}

QPushButton#btnAgvStop {
    background-color: rgba(239, 111, 108, 90);
    color: #c44a47;
    border: none;
    border-radius: 14px;
    padding: 0;
    min-height: 0;
    font-size: 14px;
    font-weight: bold;
}
QPushButton#btnAgvStop:hover {
    background-color: #ef6f6c;
    color: #ffffff;
}
QPushButton#btnAgvStop:pressed {
    background-color: #c44a47;
    color: #ffffff;
}
QPushButton#btnAgvStop:disabled {
    background-color: rgba(220, 228, 238, 120);
    color: #8a99ad;
}

/* AGV 状态标签 */
QLabel#lblAgvSpeedVal {
    color: #0078D4;
    font-weight: bold;
    font-size: 13px;
}
QLabel#lblAgvX, QLabel#lblAgvY, QLabel#lblAgvAngle,
QLabel#lblAgvBattery, QLabel#lblAgvStation, QLabel#lblAgvState {
    color: #5A6478;
    font-size: 12px;
    background: transparent;
}

/* ---------- 机械臂使能 ---------- */
QLabel#lblLeftArmTitle, QLabel#lblLeftArmTag {
    color: #0078D4;
    font-weight: bold;
    font-size: 12px;
    background: transparent;
}
QLabel#lblRightArmTitle, QLabel#lblRightArmTag {
    color: #6A1B9A;
    font-weight: bold;
    font-size: 12px;
    background: transparent;
}
/* 使能: 未使能=海蓝玻璃，已使能(checked)=薄荷玻璃 */
QPushButton#btnLeftArmEnable, QPushButton#btnRightArmEnable {
    background-color: rgba(74, 144, 226, 90);
    color: #357abd;
    border: none;
    border-radius: 10px;
    font-weight: bold;
    font-size: 13px;
    padding: 7px 16px;
}
QPushButton#btnLeftArmEnable:hover, QPushButton#btnRightArmEnable:hover {
    background-color: #4a90e2;
    color: #ffffff;
}
QPushButton#btnLeftArmEnable:pressed, QPushButton#btnRightArmEnable:pressed {
    background-color: #357abd;
    color: #ffffff;
    padding-top: 8px;
    padding-bottom: 6px;
}
QPushButton#btnLeftArmEnable:checked, QPushButton#btnRightArmEnable:checked {
    background-color: rgba(94, 201, 159, 90);
    color: #3fa37a;
}
QPushButton#btnLeftArmEnable:checked:hover, QPushButton#btnRightArmEnable:checked:hover {
    background-color: #5ec99f;
    color: #ffffff;
}

/* 拖动: 淡紫玻璃 (特殊模式)；拖动中由代码设置 dragging 属性，黄色醒目警示 */
QPushButton#btnLeftArmDrag, QPushButton#btnRightArmDrag {
    background-color: rgba(167, 139, 207, 90);
    color: #8466b3;
    border: none;
    border-radius: 10px;
    font-weight: bold;
    font-size: 13px;
    padding: 7px 16px;
}
QPushButton#btnLeftArmDrag:hover, QPushButton#btnRightArmDrag:hover {
    background-color: #a78bcf;
    color: #ffffff;
}
QPushButton#btnLeftArmDrag:pressed, QPushButton#btnRightArmDrag:pressed {
    background-color: #8466b3;
    color: #ffffff;
    padding-top: 8px;
    padding-bottom: 6px;
}
QPushButton#btnLeftArmDrag[dragging="true"], QPushButton#btnRightArmDrag[dragging="true"] {
    background-color: rgba(250, 200, 80, 220);
    color: #5a3d00;
}
QPushButton#btnLeftArmDrag[dragging="true"]:hover, QPushButton#btnRightArmDrag[dragging="true"]:hover {
    background-color: #f4a261;
    color: #ffffff;
}
QLabel#lblLeftArmEnabled, QLabel#lblRightArmEnabled {
    color: #777;
    font-size: 11px;
    background: transparent;
}

/* ---------- 机械臂速度 ---------- */
QLabel#lblArmSpeedVal {
    color: #0078D4;
    font-weight: bold;
    font-size: 16px;
}
QLabel#lblArmSpeedHint {
    color: #777;
    font-size: 10px;
    background: transparent;
}

/* ---------- 机械臂项目状态 ---------- */
QLabel#lblArmProjectStatus {
    color: #5A6478;
    font-size: 11px;
    background: transparent;
}

/* ---------- 升降柱高度大字号 ---------- */
QLabel#lblLiftHeight {
    color: #0078D4;
    font-size: 24pt;
    font-weight: bold;
    background: transparent;
}
QLabel#lblLiftHeightTitle, QLabel#lblLiftLimits {
    color: #5A6478;
    font-size: 10pt;
    background: transparent;
}
QLabel#lblLiftOnline, QLabel#lblLiftEnabled,
QLabel#lblLiftMoving, QLabel#lblLiftFault {
    color: #777;
    font-size: 11px;
    background: transparent;
}

/* ---------- 升降柱告警 ---------- */
QLabel#lblLiftAlert {
    color: white;
    background: transparent;
    border-radius: 4px;
    padding: 2px 8px;
    font-weight: bold;
}

/* ---------- 关节角/末端位姿 (左/右臂标签) ---------- */
QLabel#lblLeftPoseTag, QLabel#lblRightPoseTag {
    color: #5A6478;
    font-size: 11px;
    background: transparent;
}
QLabel[lbl^="lblLeft"], QLabel[lbl^="lblRight"] {
    color: #1E1E1E;
    background: transparent;
}

/* ---------- 右侧滚动区域：背景透明，保留页面底色 ---------- */
QScrollArea#armScroll,
QScrollArea#liftScroll,
QScrollArea#handScroll {
    background: transparent;
    border: none;
}
QScrollArea#armScroll > QWidget > QWidget,
QScrollArea#liftScroll > QWidget > QWidget,
QScrollArea#handScroll > QWidget > QWidget {
    background: transparent;
}

/* ---------- QSplitter 手柄 ---------- */
QSplitter#mainSplitter::handle {
    background-color: transparent;
}
QSplitter#mainSplitter::handle:horizontal {
    width: 10px;
}
QSplitter#mainSplitter::handle:horizontal:hover {
    background-color: rgba(0, 120, 212, 30);
    border-radius: 5px;
}

/* ---------- 通用 Slider ---------- */
QSlider::groove:horizontal {
    height: 6px;
    background: #E0E6F0;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: #0078D4;
    width: 16px;
    margin: -5px 0;
    border-radius: 8px;
}
QSlider::handle:horizontal:hover {
    background: #1A88E4;
}
QSlider::sub-page:horizontal {
    background: #0078D4;
    border-radius: 3px;
}

/* ---------- 通用 ComboBox ---------- */
QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #D0D6E0;
    border-radius: 6px;
    padding: 4px 8px;
    min-height: 22px;
}
QComboBox:hover { border-color: #0078D4; }
QComboBox::drop-down { border: none; width: 20px; }

/* ---------- 通用 SpinBox / DoubleSpinBox ---------- */
QSpinBox, QDoubleSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #D0D6E0;
    border-radius: 6px;
    padding: 4px 6px;
    min-height: 22px;
}
QSpinBox:focus, QDoubleSpinBox:focus { border-color: #0078D4; }
